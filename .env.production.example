# ============================================================================
# OLLMCHS Library — Production Environment Configuration
# ============================================================================
# Copy this file to .env and update ALL values for your production server.
#   cp .env.production.example .env
# Then run: php artisan key:generate
# ============================================================================

# --- Application ---
APP_NAME="OLLMCHS Library"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Generate a unique key: php artisan key:generate
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL recommended for production) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ollmchs_library
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# --- Cache (Redis recommended for production) ---
CACHE_STORE=redis

# --- Session ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com
SESSION_SAME_SITE=lax

# --- Queue (Redis or database) ---
QUEUE_CONNECTION=redis

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Broadcasting ---
BROADCAST_CONNECTION=log

# --- Filesystem ---
FILESYSTEM_DISK=local

# --- Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=465
MAIL_USERNAME=your-email@your-domain.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe (optional — for subscription payments) ---
STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- M-Pesa (optional — for mobile payments) ---
# NOTE: .env key names must match config/mpesa.php expectations:
#   MPESA_CONSUMER_KEY        → mpesa.consumer_key
#   MPESA_CONSUMER_SECRET     → mpesa.consumer_secret
#   MPESA_PASS_KEY            → mpesa.pass_key          (NOT MPESA_PASSKEY)
#   MPESA_SHORT_CODE          → mpesa.short_code        (NOT MPESA_SHORTCODE)
#   MPESA_ENV                 → mpesa.env               (NOT MPESA_ENVIRONMENT)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASS_KEY=
MPESA_SHORT_CODE=174379
MPESA_ENV=production

# --- Two-Factor Authentication ---
TWO_FACTOR_ENABLED=true

# --- Sanctum (API domains) ---
SANCTUM_STATEFUL_DOMAINS=your-domain.com,api.your-domain.com

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
