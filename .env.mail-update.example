# ===== Mail Configuration Update =====
# Please update these values in your .env file:
# 
# Replace these lines:
# MAIL_MAILER=log
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="library@ollmchs.ac.ke"
# MAIL_FROM_NAME="${APP_NAME}"
#
# With your SMTP credentials:
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="library@yourdomain.ac.ke"
MAIL_FROM_NAME="${APP_NAME}"
